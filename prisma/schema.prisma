  phone_number_id      String                 @unique @db.VarChar(100)
  display_phone_number String?                @db.VarChar(30)
  verified_name        String?                @db.VarChar(255)
  status               whatsapp_number_status @default(active)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  messages             messages[]
  meta_accounts        meta_accounts          @relation(fields: [meta_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  whatsapp_templates   whatsapp_templates[]

  @@index([id], map: "ix_whatsapp_numbers_id")
  @@index([meta_account_id], map: "ix_whatsapp_numbers_meta_account_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model whatsapp_templates {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  whatsapp_number_id String           @db.Uuid
  meta_template_id   String?          @db.VarChar(100)
  name               String           @db.VarChar(255)
  language_code      String           @db.VarChar(20)
  category           String?          @db.VarChar(50)
  status             template_status  @default(pending)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @db.Timestamptz(6)
  whatsapp_numbers   whatsapp_numbers @relation(fields: [whatsapp_number_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "ix_whatsapp_templates_id")
  @@index([whatsapp_number_id], map: "ix_whatsapp_templates_whatsapp_number_id")
}

