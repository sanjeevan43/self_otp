  processed_at    DateTime? @db.Timestamptz(6)
  id              String    @id @db.Uuid
  created_at      DateTime  @db.Timestamptz(6)
  updated_at      DateTime  @db.Timestamptz(6)

  @@index([id], map: "ix_meta_webhook_events_id")
  @@index([meta_message_id], map: "ix_meta_webhook_events_meta_message_id")
  @@index([status], map: "ix_meta_webhook_events_status")
}

model notifications {
  customer_id String    @db.Uuid
  title       String    @db.VarChar(200)
  message     String
  type        String    @db.VarChar(50)
  is_read     Boolean
  read_at     DateTime? @db.Timestamptz(6)
  id          String    @id @db.Uuid
  created_at  DateTime  @db.Timestamptz(6)
  updated_at  DateTime  @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "ix_notifications_customer_id")
  @@index([id], map: "ix_notifications_id")
}

