generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model api_keys {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id    String          @db.Uuid
  name           String          @db.VarChar(100)
  key_prefix     String          @db.VarChar(20)
  key_hash       String          @unique(map: "ix_api_keys_key_hash")
  status         api_key_status  @default(active)
  expires_at     DateTime?       @db.Timestamptz(6)
  last_used_at   DateTime?       @db.Timestamptz(6)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  revoked_at     DateTime?       @db.Timestamptz(6)
  application_id String          @db.Uuid
  environment    environmenttype @default(DEVELOPMENT)
  updated_at     DateTime        @db.Timestamptz(6)
  applications   applications    @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers      customers       @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  otp_requests   otp_requests[]

  @@index([application_id], map: "ix_api_keys_application_id")
  @@index([customer_id], map: "ix_api_keys_customer_id")
  @@index([id], map: "ix_api_keys_id")
  @@index([status], map: "ix_api_keys_status")
}

model api_request_logs {
  org_id           String?  @db.Uuid
  api_key_id       String?  @db.Uuid
  endpoint         String   @db.VarChar(100)
  method           String   @db.VarChar(10)
  status_code      Int
  response_time_ms Float
  ip_address       String   @db.VarChar(45)
  user_agent       String?
  id               String   @id @db.Uuid
  created_at       DateTime @db.Timestamptz(6)
  updated_at       DateTime @db.Timestamptz(6)

  @@index([api_key_id], map: "ix_api_request_logs_api_key_id")
  @@index([id], map: "ix_api_request_logs_id")
  @@index([org_id], map: "ix_api_request_logs_org_id")
}

model applications {
  customer_id      String             @db.Uuid
  name             String             @db.VarChar(100)
  description      String?
  id               String             @id @db.Uuid
  created_at       DateTime           @db.Timestamptz(6)
  updated_at       DateTime           @db.Timestamptz(6)
  api_keys         api_keys[]
  customers        customers          @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  idempotency_keys idempotency_keys[]
  otp_requests     otp_requests[]
  webhook_configs  webhook_configs[]

  @@index([customer_id], map: "ix_applications_customer_id")
  @@index([id], map: "ix_applications_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?    @db.Uuid
  customer_id   String?    @db.Uuid
  action        String     @db.VarChar(100)
  resource_type String?    @db.VarChar(100)
  resource_id   String?    @db.Uuid
  ip_address    String?    @db.VarChar(45)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  metadata_json Json?      @db.Json
  customers     customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users?     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "ix_audit_logs_created_at")
  @@index([customer_id], map: "ix_audit_logs_customer_id")
  @@index([id], map: "ix_audit_logs_id")
  @@index([user_id], map: "ix_audit_logs_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customer_users {
  customer_id String        @db.Uuid
  user_id     String        @db.Uuid
  role        customer_role @default(member)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  customers   customers     @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([customer_id, user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customers {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name       String               @db.VarChar(255)
  email              String               @unique(map: "ix_customers_email") @db.VarChar(255)
  phone              String?              @db.VarChar(20)
  status             customer_status      @default(active)
  country_code       String               @default("+91") @db.VarChar(5)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  api_keys           api_keys[]
  applications       applications[]
  audit_logs         audit_logs[]
  customer_users     customer_users[]
  idempotency_keys   idempotency_keys[]
  messages           messages[]
  meta_accounts      meta_accounts[]
  notifications      notifications[]
  otp_requests       otp_requests[]
  payment_orders     payment_orders[]
  rate_limit_records rate_limit_records[]
  wallets            wallets?

  @@index([id], map: "ix_customers_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model idempotency_keys {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id     String       @db.Uuid
  idempotency_key String       @db.VarChar(255)
  endpoint        String       @db.VarChar(255)
  request_hash    String
  response_status Int?
  response_body   Json?        @db.Json
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  application_id  String       @db.Uuid
  applications    applications @relation(fields: [application_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers       customers    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([application_id], map: "ix_idempotency_keys_application_id")
  @@index([customer_id], map: "ix_idempotency_keys_customer_id")
  @@index([id], map: "ix_idempotency_keys_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model message_events {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id          String             @db.Uuid
  event_type          message_event_type
  provider_message_id String?            @db.VarChar(255)
  event_data          Json?              @db.Json
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  messages            messages           @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_type], map: "ix_message_events_event_type")
  @@index([id], map: "ix_message_events_id")
  @@index([message_id], map: "ix_message_events_message_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model messages {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id         String            @db.Uuid
  otp_request_id      String?           @db.Uuid
  whatsapp_number_id  String?           @db.Uuid
  provider            String            @default("meta") @db.VarChar(50)
  provider_message_id String?           @db.VarChar(255)
  phone_number        String            @db.VarChar(30)
  message_type        message_type      @default(authentication)
  status              message_status    @default(queued)
  error_code          String?           @db.VarChar(100)
  error_message       String?
  sent_at             DateTime?         @db.Timestamptz(6)
  delivered_at        DateTime?         @db.Timestamptz(6)
  read_at             DateTime?         @db.Timestamptz(6)
  failed_at           DateTime?         @db.Timestamptz(6)
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @db.Timestamptz(6)
  message_events      message_events[]
  customers           customers         @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  otp_requests        otp_requests?     @relation(fields: [otp_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  whatsapp_numbers    whatsapp_numbers? @relation(fields: [whatsapp_number_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id], map: "ix_messages_customer_id")
  @@index([id], map: "ix_messages_id")
  @@index([otp_request_id], map: "ix_messages_otp_request_id")
  @@index([provider_message_id], map: "ix_messages_provider_message_id")
  @@index([status], map: "ix_messages_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
