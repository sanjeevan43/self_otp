# Environment Configuration (TypeScript / Fastify / Prisma / BullMQ)
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# Database & Redis (Standard PostgreSQL URL for Prisma & Redis URL for BullMQ)
DATABASE_URL=postgresql://postgres:1234!%40%23%24QWERqwer@localhost:5432/self_otp_db
# POSTGRES_PRISMA_URL=postgresql://postgres:1234!%40%23%24QWERqwer@localhost:5432/self_otp_db
REDIS_URL=redis://localhost:6379/0

# Security & Tokens
SECRET_KEY=change_this_to_a_secure_64_character_random_hex_string
PEPPER=change_this_to_a_secure_pepper_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Provider Configuration: "meta" (production) or "mock" (offline testing)
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API Credentials
META_API_VERSION=v20.0
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WABA_ID=your_meta_waba_id
META_ACCESS_TOKEN=your_meta_system_user_access_token
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token

# OTP Lifecycle & Rate Limiting Defaults
DEFAULT_API_KEY_RATE_LIMIT_RPS=60
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=3
OTP_CREDIT_COST=1.0000
